# ─────────────────────────────────────────────────────────────────────────────
# TaskFlow — configuration
#
# Copy this file to `.env` and adjust. `.env` is gitignored; this file is not.
# Every service reads its config from environment variables only — nothing is
# hardcoded, and nothing is read from a file that isn't this one.
#
#   cp .env.example .env
#
# Values below are safe development defaults. Do not use them anywhere real.
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────────────────────
# Used by the `db` container to initialise itself, and by the backend to
# connect. Only the backend ever talks to Postgres.

POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev_only
POSTGRES_DB=taskflow

# Host port Postgres is published on. Change if 5432 is already taken by a
# Postgres you have installed locally.
POSTGRES_PORT=5432


# ── Backend (fastapi-backend) ────────────────────────────────────────────────

BACKEND_PORT=8000

# Note the hostname is `db` — inside the Compose network, services reach each
# other by service name, not localhost.
DATABASE_URL=postgresql+psycopg://taskflow:taskflow_dev_only@db:5432/taskflow

# The signing key for JWTs.
#
# IMPORTANT: the mcp-server uses this SAME secret to verify tokens it receives,
# so the two services must always agree. That shared value is the reason the MCP
# server can reject a forged token instantly instead of asking the backend.
# (The backend still re-verifies — it is the real authority. See PLAN.md §6.)
#
# Generate a real one with:  openssl rand -hex 32
JWT_SECRET=dev_secret_change_me_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Where browsers are allowed to call the API from (the frontend and chat client).
CORS_ORIGINS=http://localhost:5173,http://localhost:8100


# ── MCP server (mcp-server) ──────────────────────────────────────────────────

MCP_PORT=9000

# The MCP server calls the backend over HTTP like any other client. It has no
# database connection and no credentials of its own — every request it makes
# carries the token of the human whose AI is asking.
BACKEND_URL=http://fastapi-backend:8000


# ── Chat client (chat-client) ────────────────────────────────────────────────

CHAT_PORT=8100
MCP_SERVER_URL=http://mcp-server:9000/mcp

# Signs the browser session cookie for the chat UI. Unrelated to JWT_SECRET —
# a different secret for a different job.
SESSION_SECRET=dev_session_secret_change_me


# ── The LLM ──────────────────────────────────────────────────────────────────
# The chat client is not tied to any vendor. Exactly one file
# (chat-client/app/llm.py) reads these; nothing else in the repo imports a
# provider SDK.
#
# Format is "provider:model". Uncomment the one you want and set its API key.

LLM_MODEL=anthropic:claude-opus-4-8
# LLM_MODEL=openai:gpt-4.1
# LLM_MODEL=google_genai:gemini-2.0-flash
# LLM_MODEL=ollama:qwen2.5:14b          # runs locally; no API key needed

LLM_TEMPERATURE=0

# Set only the key for the provider you selected above.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional: route everything through an OpenAI-compatible gateway instead
# (LiteLLM, vLLM, OpenRouter, Groq, LM Studio). Set LLM_MODEL to
# "openai:<whatever-you-named-it>" and point this at the gateway.
# OPENAI_API_BASE=http://litellm:4000

# Optional: give a weaker model a smaller menu. Comma-separated tool names;
# empty means "all tools". See PLAN.md §9.2 for why this exists.
# LLM_ALLOWED_TOOLS=list_projects,list_tasks,create_task,update_task_status


# ── Frontend ─────────────────────────────────────────────────────────────────

FRONTEND_PORT=5173

# The browser calls the API directly, so this is a localhost URL — not the
# in-network `http://fastapi-backend:8000` the other services use.
VITE_API_URL=http://localhost:8000
