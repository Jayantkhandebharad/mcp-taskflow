# ── Secrets and local config ─────────────────────────────────────────────────
# `.env.example` IS committed. `.env` never is — it holds real API keys.
.env
.env.local
.env.*.local

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

# ── Editors and OS ───────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# ── Local scratch ────────────────────────────────────────────────────────────
# Screenshots and exports generated while writing the blog posts.
/tmp/
/scratch/

# ── Claude Code local tooling ────────────────────────────────────────────────
# Local runtime state (e.g. scheduled_tasks.lock) stays out of git. The /learn
# skill and its progress log ARE committed on purpose — they sync across machines
# via GitHub. Ignore everything in .claude, then re-include just the learn skill.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/learn/
